  "externals": {},
  "localizedResources": {
    "ITSystemStatusCardAdaptiveCardExtensionStrings": "lib/adaptiveCardExtensions/itSystemStatusCard/loc/{locale}.js",
    "LunchMenuCardAdaptiveCardExtensionStrings": "lib/adaptiveCardExtensions/lunchMenuCard/loc/{locale}.js",
    "SiteAnalyticsCardAdaptiveCardExtensionStrings": "lib/adaptiveCardExtensions/siteAnalyticsCard/loc/{locale}.js",
    "SupportTicketsCardAdaptiveCardExtensionStrings": "lib/adaptiveCardExtensions/supportTicketsCard/loc/{locale}.js",

        {
          "entrypoint": "./lib/adaptiveCardExtensions/lunchMenuCard/LunchMenuCardAdaptiveCardExtension.js",
          "manifest": "./src/adaptiveCardExtensions/lunchMenuCard/LunchMenuCardAdaptiveCardExtension.manifest.json"
        }
      ]
    },
    "site-analytics-card-adaptive-card-extension": {
      "components": [
        {
          "entrypoint": "./lib/adaptiveCardExtensions/siteAnalyticsCard/SiteAnalyticsCardAdaptiveCardExtension.js",
          "manifest": "./src/adaptiveCardExtensions/siteAnalyticsCard/SiteAnalyticsCardAdaptiveCardExtension.manifest.json"
        }
      ]

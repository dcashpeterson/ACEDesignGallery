{
  "schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "◀",
                  "data": { "id": "cancel" }
                }
              ]
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "Update Request",
              "weight": "Bolder",
              "size": "Medium"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${title}",
      "weight": "Bolder",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "FactSet",
      "spacing": "Small",
      "facts": [
        { "title": "Category", "value": "${category}" },
        { "title": "Location", "value": "${location}" },
        { "title": "Priority", "value": "${priority}" },
        { "title": "Requested by", "value": "${requestedByName}" }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "updateStatus",
      "label": "Update Status",
      "value": "${currentStatus}",
      "spacing": "Medium",
      "choices": [
        { "title": "In Progress", "value": "In Progress" },
        { "title": "Resolved - Pending Validation", "value": "Resolved - Pending Validation" },
        { "title": "Cancelled", "value": "Cancelled" }
      ]
    },
    {
      "type": "Input.Text",
      "id": "maintenanceNotes",
      "label": "Maintenance Notes",
      "placeholder": "Describe the work done or current status",
      "isMultiline": true,
      "value": "${currentNotes}"
    },
    {
      "type": "ActionSet",
      "spacing": "Medium",
      "actions": [
        {
          "type": "Action.Submit",
          "title": "Save Update",
          "style": "positive",
          "data": { "id": "update", "requestId": "${requestId}" }
        },
        {
          "type": "Action.Submit",
          "title": "Cancel",
          "data": { "id": "cancel" }
        }
      ]
    }
  ]
}

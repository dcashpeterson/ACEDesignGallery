{
  "schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "◀",
                  "data": { "id": "cancel" }
                }
              ]
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "Validate Completion",
              "weight": "Bolder",
              "size": "Medium"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${title}",
      "weight": "Bolder",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "FactSet",
      "spacing": "Small",
      "facts": [
        { "title": "Status", "value": "${status}" },
        { "title": "Category", "value": "${category}" },
        { "title": "Location", "value": "${location}" },
        { "title": "Priority", "value": "${priority}" },
        { "title": "Requested by", "value": "${requestedByName}" }
      ]
    },
    {
      "type": "Container",
      "spacing": "Small",
      "$when": "${hasMaintenanceNotes}",
      "style": "emphasis",
      "items": [
        {
          "type": "TextBlock",
          "text": "Maintenance Notes",
          "weight": "Bolder",
          "size": "Small"
        },
        {
          "type": "TextBlock",
          "text": "${maintenanceNotes}",
          "wrap": true,
          "size": "Small",
          "spacing": "None"
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "managerNotes",
      "label": "Manager Notes",
      "placeholder": "Add notes about this review decision",
      "isMultiline": true,
      "spacing": "Medium"
    },
    {
      "type": "ActionSet",
      "spacing": "Medium",
      "actions": [
        {
          "type": "Action.Submit",
          "title": "✓ Approve Completion",
          "style": "positive",
          "data": { "id": "approve", "requestId": "${requestId}" }
        },
        {
          "type": "Action.Submit",
          "title": "↩ Send Back to Maintenance",
          "data": { "id": "reject", "requestId": "${requestId}" }
        },
        {
          "type": "Action.Submit",
          "title": "Cancel",
          "data": { "id": "cancel" }
        }
      ]
    }
  ]
}

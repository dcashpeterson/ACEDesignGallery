{
  "schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "◀",
                  "data": { "id": "back" }
                }
              ]
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "weight": "Bolder",
              "text": "My Tickets",
              "size": "Medium"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "You haven't submitted any tickets yet.",
      "isSubtle": true,
      "size": "Small",
      "spacing": "Medium",
      "$when": "${count(tickets) == 0}"
    },
    {
      "type": "Container",
      "$data": "${tickets}",
      "spacing": "Small",
      "separator": true,
      "selectAction": {
        "type": "Action.Submit",
        "data": {
          "id": "select",
          "ticketId": "${id}",
          "title": "${title}",
          "status": "${status}",
          "priority": "${priority}",
          "description": "${description}",
          "submittedDate": "${submittedDate}",
          "assignedTo": "${assignedTo}"
        }
      },
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${title}",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${if(submittedDate != '', submittedDate, 'No date')}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${status}",
                  "size": "Small",
                  "color": "Attention",
                  "$when": "${status == 'Escalated'}"
                },
                {
                  "type": "TextBlock",
                  "text": "${status}",
                  "size": "Small",
                  "color": "Accent",
                  "$when": "${status == 'Open'}"
                },
                {
                  "type": "TextBlock",
                  "text": "${status}",
                  "size": "Small",
                  "color": "Warning",
                  "$when": "${status == 'In Progress'}"
                },
                {
                  "type": "TextBlock",
                  "text": "${status}",
                  "size": "Small",
                  "color": "Good",
                  "$when": "${status == 'Resolved'}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

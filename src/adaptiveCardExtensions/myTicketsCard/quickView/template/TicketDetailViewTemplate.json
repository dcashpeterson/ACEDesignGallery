{
  "schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "◀",
                  "data": { "id": "back" }
                }
              ]
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "weight": "Bolder",
              "text": "Ticket Details",
              "size": "Medium"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${title}",
      "weight": "Bolder",
      "size": "Large",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Status:",
              "weight": "Bolder",
              "size": "Small"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${status}",
              "size": "Small",
              "color": "Attention",
              "$when": "${status == 'Escalated'}"
            },
            {
              "type": "TextBlock",
              "text": "${status}",
              "size": "Small",
              "color": "Accent",
              "$when": "${status == 'Open'}"
            },
            {
              "type": "TextBlock",
              "text": "${status}",
              "size": "Small",
              "color": "Warning",
              "$when": "${status == 'In Progress'}"
            },
            {
              "type": "TextBlock",
              "text": "${status}",
              "size": "Small",
              "color": "Good",
              "$when": "${status == 'Resolved'}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Priority:",
              "weight": "Bolder",
              "size": "Small"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${priority}",
              "size": "Small"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Submitted:",
              "weight": "Bolder",
              "size": "Small"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${if(submittedDate != '', submittedDate, '—')}",
              "size": "Small"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Assigned To:",
              "weight": "Bolder",
              "size": "Small"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${if(assignedTo != '', assignedTo, 'Unassigned')}",
              "size": "Small"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Description",
      "weight": "Bolder",
      "size": "Small",
      "spacing": "Medium",
      "$when": "${description != ''}"
    },
    {
      "type": "TextBlock",
      "text": "${description}",
      "size": "Small",
      "isSubtle": true,
      "wrap": true,
      "spacing": "None",
      "$when": "${description != ''}"
    }
  ]
}

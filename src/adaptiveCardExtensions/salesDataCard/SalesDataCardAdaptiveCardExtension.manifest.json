    "group": { "default": "Dashboard" },
    "title": { "default": "Sales Performance" },
    "description": { "default": "View sales performance by salesperson, region, or product" },
    "officeFabricIconFontName": "LineChart",
    "properties": {
      "title": "Sales Performance",
      "siteUrl": ""
    },
    "cardSize": "Medium"
  }]
}
